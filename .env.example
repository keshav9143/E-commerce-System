# ─────────────────────────────────────────────────────────────────────────────
# CartOS — environment variable template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Flask runtime
FLASK_APP=run.py
FLASK_CONFIG=development

# Session signing key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string-before-running

# ── MySQL connection ───────────────────────────────────────────────────────────
# Full SQLAlchemy URL (takes precedence if set).
DATABASE_URL=mysql+pymysql://cartos_user:your_password@localhost:3306/cartos_db

# Individual components (used only if DATABASE_URL is not set).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=cartos_user
MYSQL_PASSWORD=your_password
MYSQL_DB=cartos_db

# ── Engine tuning (used by the worker pool in Phase 4) ────────────────────────
# Number of worker threads to start with `flask engine start`.
ENGINE_WORKER_COUNT=2
# Seconds before a RUNNING task with no heartbeat is assumed crashed.
ENGINE_HEARTBEAT_TIMEOUT=60
# Seconds before a RUNNING task is considered stuck regardless of heartbeat.
ENGINE_TASK_TIMEOUT=300
